{
  "name": "@web-ai-sdk-apps/landing",
  "version": "0.0.0",
  "private": true,
  "description": "Landing page for web-ai-sdk (Vite + React + real @web-ai-sdk hooks)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-llms.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "og:build": "node scripts/build-og-image.mjs",
    "llms:build": "node scripts/build-llms.mjs"
  },
  "dependencies": {
    "@web-ai-sdk/detector": "workspace:*",
    "@web-ai-sdk/prompt": "workspace:*",
    "@web-ai-sdk/proofreader": "workspace:*",
    "@web-ai-sdk/rewriter": "workspace:*",
    "@web-ai-sdk/summarizer": "workspace:*",
    "@web-ai-sdk/translator": "workspace:*",
    "@web-ai-sdk/webmcp": "workspace:*",
    "@web-ai-sdk/writer": "workspace:*",
    "marked": "^18.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
