{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-ai-sdk-docs-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "routes": [
    {
      "pattern": "mcp.web-ai-sdk.dev",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "271211",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
