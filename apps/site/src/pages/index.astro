const supportVersionTone = (value: string) => {
  if (value.includes("stable")) return ui.supportVersionOk;
  // Canary/Dev previews are also flag-gated; keep the preview tone so the
  // channel requirement reads as the primary signal, not the flag.
  if (value.includes("Canary/Dev")) return ui.supportVersionPreview;
  if (
    value.includes("Developer trial") ||
    value.includes("flag") ||
    value.includes("OT")
  )
    return ui.supportVersionFlag;
  return ui.supportVersionPreview;
};

// Capability matrix: lifecycle features the SDK layer provides per API.
// Cells reflect actual package behavior, verified against each package's
// source: streaming = the wrapper consumes the browser's *Streaming API
// (index.ts); session = config-keyed LRU session cache (api.ts,
// getOrCreate* + clear*Sessions); cache = opt-in sessionStorage-backed
// result cache (cache.ts); abort = AbortSignal wiring.
interface MatrixRow {
  pkg: string;
  streaming: boolean;
  session: boolean;
  cache: boolean;
  abort: boolean;
}

const matrixRows: MatrixRow[] = [
  { pkg: "prompt", streaming: true, session: true, cache: true, abort: true },
  { pkg: "webmcp", streaming: false, session: false, cache: false, abort: true },
  { pkg: "summarizer", streaming: true, session: true, cache: true, abort: true },
  { pkg: "translator", streaming: false, session: true, cache: true, abort: true },
  { pkg: "detector", streaming: false, session: true, cache: true, abort: true },
  { pkg: "writer", streaming: true, session: true, cache: true, abort: true },
  { pkg: "rewriter", streaming: true, session: true, cache: true, abort: true },
  { pkg: "proofreader", streaming: false, session: true, cache: true, abort: true },
];

const matrixColumns = [
  { key: "streaming", label: "Streaming" },
  { key: "session", label: "Session reuse" },
  { key: "cache", label: "Result cache" },
  { key: "abort", label: "AbortSignal" },
] as const;

// Browser marks from SVG Logos via Iconify (CC0).
const browserColumns = [
