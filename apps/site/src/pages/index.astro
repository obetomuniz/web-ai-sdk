    </script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:site_name" content="web-ai-sdk" />
    <meta property="og:title" content="web-ai-sdk | TypeScript SDK for the Web AI surface" />
    <meta property="og:description" content="web-ai-sdk is a TypeScript SDK for the Web AI surface: Prompt, Writer, Rewriter, Proofreader, Translator, Summarizer, Language Detector, and WebMCP. Composable, zero runtime deps." />
