          {
            packageRows.map((pkg) => (
              <div class={`${ui.pkgRow} ${ui.reveal}`} data-reveal id={pkg.slug}>
                <div class={ui.pkgLeft}>
                  <div class={ui.pkgIcon} aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={packageIcons[pkg.slug] ?? ""} />
                  </div>
                  <div class={ui.pkgName}><span class={ui.scope}>@web-ai-sdk/</span>{pkg.title}</div>
                  <div class={ui.pkgTag}>{pkg.tag}</div>
                  <ul class={ui.pkgBullets}>
                    {pkg.bullets.map(([strong, text]) => (
                      <li><span><b>{strong}</b> {text}</span></li>
                    ))}
                  </ul>
                  <div class={ui.pkgActions}>
                    <code class={ui.pkgInstall}>
                      <span class={ui.pkgInstallPrompt}>$</span> npm install <span class={ui.pkgInstallPkg}>@web-ai-sdk/{pkg.title}</span>
                    </code>
                    <a class={ui.pkgDocs} href={guideLink(pkg.slug)}>Read the docs <span class={ui.pkgDocsArrow}>→</span></a>
                  </div>
                </div>
                <div class={ui.pkgRight}>
                  {pkg.slug === "prompt" && <PromptDemo client:visible />}
                  {pkg.slug === "webmcp" && <WebMCPDemo client:visible />}
                  {pkg.slug === "summarizer" && <SummarizerDemo client:visible />}
                  {pkg.slug === "translator" && <TranslatorDemo client:visible />}
                  {pkg.slug === "detector" && <DetectorDemo client:visible />}
                  {pkg.slug === "writer" && <WriterDemo client:visible />}
                  {pkg.slug === "rewriter" && <RewriterDemo client:visible />}
                  {pkg.slug === "proofreader" && <ProofreaderDemo client:visible />}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class={ui.section} data-section="philosophy">
        <div class={ui.container}>
          <div class={`${ui.sectionHead} ${ui.sectionAnchor}`} id="philosophy">
            <div>
              <div class={ui.sectionEyebrow}>philosophy</div>
              <h2 class="mt-2">Why composable.</h2>
            </div>
            <a class={ui.permalink} href="#philosophy"><span aria-hidden="true">§</span><span class={ui.srOnly}>Link to Philosophy section</span></a>
          </div>
          <div class={`${ui.twoCol} ${ui.reveal}`} data-reveal>
            <div>
              <h3 class={ui.philosophyTitle}><span class={ui.philosophyNum}>01</span> We handle the rough edges.</h3>
              <p class={ui.philosophyText}>
                The built-in AI surface is young. Capability checks, model downloads, abortable streams, session lifetimes, and DOM-rebuild safety are all things you would otherwise re-implement in every component.
              </p>
              <ul class={ui.philosophyList}>
                <li>Feature detection per package</li>
                <li>Session cache keyed by config</li>
                <li>AsyncIterable streams plus AbortSignal cleanup</li>
                <li>Hot-reload and StrictMode safe</li>
                <li>Zero-runtime fallback when API missing</li>
              </ul>
            </div>
            <div>
              <h3 class={ui.philosophyTitle}><span class={ui.philosophyNum}>02</span> You compose the stack.</h3>
              <p class={ui.philosophyText}>
                We ship the lifecycle layer: state machines, streams, abort signals. Framework adapters, polyfills, and UI primitives stay optional so they do not constrain your design system.
              </p>
              <ul class={ui.philosophyList}>
                <li>Framework-agnostic core</li>
                <li>Optional <code>/react</code> subpath</li>
                <li>No global state, no providers required</li>
                <li>Tree-shakable per package</li>
                <li>Pick the layers you need</li>
              </ul>
            </div>
          </div>
          <div class={`${ui.stackDiagram} ${ui.reveal}`} data-reveal>
            <div class={ui.stackHeader}><span>Architecture</span><span>Owner</span></div>
            <div class={`${ui.stackRowBase} ${ui.stackRowApi}`}>
              <span class={ui.stackIdx}>00</span>
              <div class={ui.stackBody}>
                <div class={`${ui.stackName} ${ui.stackNameMuted}`}>Browser built-in AI</div>
                <div class={`${ui.stackDetail} ${ui.stackDetailMuted}`}>document.modelContext, Summarizer, Translator, LanguageModel, LanguageDetector, Writer, Rewriter, Proofreader</div>
              </div>
              <span class={ui.stackOwner}>platform</span>
            </div>
            <div class={ui.stackRowBase}>
              <span class={`${ui.stackIdx} ${ui.stackIdxAccent}`}>01</span>
              <div class={ui.stackBody}>
                <div class={ui.stackName}><span class={ui.scope}>@web-ai-sdk/</span>X</div>
                <div class={ui.stackDetail}>ask(), createSession(), summarize(), translate(), detect(), write(), rewrite(), proofread(), registerTool(), AbortSignal, session cache</div>
              </div>
              <span class={`${ui.stackOwner} ${ui.stackIdxAccent}`}>web-ai-sdk</span>
            </div>
            <div class={`${ui.stackRowBase} ${ui.stackRowHook}`}>
              <span class={`${ui.stackIdx} ${ui.stackIdxAccent}`}>02</span>
              <div class={ui.stackBody}>
                <div class={`${ui.stackName} ${ui.stackNameAccent}`}><span class={ui.scope}>@web-ai-sdk/</span>X<span class={ui.scope}>/react</span></div>
                <div class={ui.stackDetail}>usePrompt(), useSession(), useSummarizer(), useTranslator(), useDetector(), useWriter(), useRewriter(), useProofreader(), useWebMCP()</div>
              </div>
              <span class={`${ui.stackOwner} ${ui.stackIdxAccent}`}>web-ai-sdk</span>
            </div>
            <div class={ui.stackRowBase}>
              <span class={`${ui.stackIdx} ${ui.stackIdxMuted}`}>03</span>
              <div class={ui.stackBody}>
                <div class={ui.stackName}>Your application</div>
                <div class={ui.stackDetail}>Card, Button, Spinner, your design system</div>
              </div>
              <span class={`${ui.stackOwner} ${ui.stackIdxMuted}`}>your code</span>
            </div>
          </div>
        </div>
      </section>

      <section class={ui.section} data-section="how">
        <div class={ui.container}>
          <div class={`${ui.sectionHead} ${ui.sectionAnchor}`} id="how">
            <div>
              <div class={ui.sectionEyebrow}>how it works</div>
              <h2 class="mt-2">Same task. Three levels of abstraction.</h2>
              <p class="mt-3.5">All three tabs do the same thing: detect an article's language and summarize it into key-points. Same result, less to wire up.</p>
            </div>
            <a class={ui.permalink} href="#how"><span aria-hidden="true">§</span><span class={ui.srOnly}>Link to How it works section</span></a>
          </div>
          <div class={ui.reveal} data-reveal>
            <HowItWorks client:visible />
          </div>
        </div>
      </section>

      <section class={ui.section} data-section="support">
        <div class={ui.container}>
          <div class={`${ui.sectionHead} ${ui.sectionAnchor}`} id="support">
            <div>
              <div class={ui.sectionEyebrow}>support</div>
              <h2 class="mt-2">Browser support.</h2>
              <p class="mt-3.5">Built-in AI lands engine by engine. Where it is not there yet, you get a feature-detected no-op so your code does not crash.</p>
            </div>
            <a class={ui.permalink} href="#support"><span aria-hidden="true">§</span><span class={ui.srOnly}>Link to Browser support section</span></a>
          </div>
          <div class={ui.reveal} data-reveal>
            <div class={ui.supportWrap}>
              <table class={ui.supportTable}>
                <thead>
                  <tr>
                    <th class={ui.supportHead}>Package</th>
                    <th class={ui.supportHead}>Chrome</th>
                    <th class={ui.supportHead}>Edge</th>
                    <th class={ui.supportHead}>Safari</th>
                    <th class={ui.supportHead}>Firefox</th>
                  </tr>
                </thead>
                <tbody>
                  {supportRows.map((row) => (
                    <tr>
                      <th class={ui.supportRowHead}><span class={ui.scope}>@web-ai-sdk/</span>{row.pkg}</th>
                      <td>
                        {row.chromeHref ? (
                          <a class={`${ui.supportVersion} ${ui.supportVersionLink} ${supportVersionTone(row.chrome)}`} href={row.chromeHref} target="_blank" rel="noreferrer" title="View the source for this availability claim">{row.chrome}</a>
                        ) : (
                          <span class={`${ui.supportVersion} ${supportVersionTone(row.chrome)}`}>{row.chrome}</span>
                        )}
                      </td>
                      <td>
                        {row.edgeHref ? (
                          <a class={`${ui.supportVersion} ${ui.supportVersionLink} ${supportVersionTone(row.edge)}`} href={row.edgeHref} target="_blank" rel="noreferrer" title="View the source for this availability claim">{row.edge}</a>
                        ) : (
                          <span class={`${ui.supportVersion} ${supportVersionTone(row.edge)}`}>{row.edge}</span>
                        )}
                      </td>
                      <td><span class={`${ui.supportPill} ${ui.supportPillWarn}`}>no-op fallback</span></td>
                      <td><span class={`${ui.supportPill} ${ui.supportPillWarn}`}>no-op fallback</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class={ui.supportNote}>
              Each version links to its source. <strong>stable</strong> = on by default; <strong>Canary/Dev</strong> = preview channel, needs the matching flag; <strong>flag</strong> = normal channel, behind a flag; <strong>OT</strong> = <a class="underline underline-offset-2" href="https://developer.chrome.com/docs/web-platform/origin-trials" target="_blank" rel="noreferrer">origin trial</a>. WebMCP/Edge is empirical (no official page yet).
            </div>
          </div>
        </div>
      </section>

      <section class={`${ui.section} pb-[calc(var(--section-py)*2)]`} data-section="start">
        <div class={ui.container}>
          <div class={`${ui.ctaBlock} ${ui.sectionAnchor} ${ui.reveal}`} data-reveal id="start">
            <div class={`${ui.sectionEyebrow} mb-5 justify-center`}>ship it</div>
            <h2 class={`${ui.ctaBlockTitle} ${ui.gradientText}`}>Try it in your project.</h2>
            <p class={ui.ctaBlockText}>
              One install, all eight blocks. Or pick the individual <code>@web-ai-sdk/*</code> packages. Ships ESM, CJS, and types. Tree-shakable.
            </p>
            <InstallPill pkg="@web-ai-sdk/all" className="mx-auto" client:idle />
            <div class={ui.ctaLinks}>
              <a class={ui.ctaLink} href={docsUrl}>Read the docs <span>↗</span></a>
              <a class={ui.ctaLink} href={repoUrl} target="_blank" rel="noreferrer">GitHub repo <span>↗</span></a>
              <StarWidget repo={REPO} client:idle />
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class={ui.footer}>
      <div class={ui.container}>
        <div class={ui.footerGrid}>
          <div>
            <div class={ui.footerBrandTitle}><span>web-ai-sdk</span><span class={ui.caret}></span></div>
            <p class={ui.footerBrandText}>Building blocks for the Web's Built-in AI APIs.</p>
          </div>
          <div>
            <h3 class={ui.footerColTitle}>Project</h3>
            <ul class={ui.footerColList}>
              <li><a href={docsUrl}>Docs</a></li>
              <li><a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a></li>
              <li><a href={npmOrgUrl} target="_blank" rel="noreferrer">npm</a></li>
              <li><a href={changelogUrl} target="_blank" rel="noreferrer">Changelog</a></li>
            </ul>
          </div>
          <div>
            <h3 class={ui.footerColTitle}>Community</h3>
            <ul class={ui.footerColList}>
              <li><a href={issuesUrl} target="_blank" rel="noreferrer">Issues</a></li>
              <li><a href={discussionsUrl} target="_blank" rel="noreferrer">Discussions</a></li>
            </ul>
          </div>
          <div>
            <h3 class={ui.footerColTitle}>About</h3>
            <ul class={ui.footerColList}>
              <li>Built by <a href={authorUrl} target="_blank" rel="noreferrer">@obetomuniz</a></li>
              <li><a href={licenseUrl} target="_blank" rel="noreferrer">MIT licensed</a></li>
              <li>100% on-device</li>
            </ul>
          </div>
        </div>
        <div class={ui.footerMeta}>
          <span>web-ai-sdk v{SDK_VERSION}</span>
          <span><a href="#top" data-footer-top-link>Back to top ↑</a></span>
        </div>
      </div>
    </footer>

    <ScrollSpy client:idle />
    <BackToTop client:idle />
    {import.meta.env.DEV && <ThemeSwitcher client:idle />}
  </body>
</html>
