---
// Starlight component override. Wraps the default `<Head>` and appends a
// per-page TechArticle JSON-LD blob. Google's AI Optimization Guide doesn't
// require structured data for AI search, but recommends it as part of
// overall SEO — this gives every doc page a machine-readable identity
// (title, description, url, author, publisher) without changing visible
// markup.
import Default from "@astrojs/starlight/components/Head.astro";

// Starlight exposes route data (including `entry`) via
// `Astro.locals.starlightRoute`. The default 404 route can omit an entry, so
// keep the schema payload conditional.
const starlightRoute = (
  Astro.locals as {
    starlightRoute?: {
      id?: string;
      entry?: { id?: string; data?: { title?: string; description?: string } };
    };
  }
).starlightRoute;
const entry = starlightRoute?.entry;
const data = entry?.data;

// Per-page OG card, rendered at build time by src/pages/og/[...slug].png.ts
// from the same template as the committed home card. Entry ids are already
// prefixed ("docs", "docs/guides/prompt", …) by the content.config generateId.
const entryId = entry?.id ?? starlightRoute?.id;
const ogImage =
  entryId && Astro.site
    ? new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og/${entryId}.png`, Astro.site).href
    : undefined;
const ogImageAlt = data?.title ? `${data.title} — web-ai-sdk docs` : undefined;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

const ld = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data?.title,
  description: data?.description,
  url: canonical,
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: "Beto Muniz",
    url: "https://github.com/obetomuniz",
    sameAs: ["https://github.com/obetomuniz", "https://betomuniz.com"],
  },
  publisher: {
    "@type": "Organization",
    name: "web-ai-sdk",
    url: "https://web-ai-sdk.dev/",
    sameAs: [
      "https://github.com/obetomuniz/web-ai-sdk",
      "https://www.npmjs.com/org/web-ai-sdk",
    ],
  },
  isPartOf: {
    "@type": "WebSite",
    name: "web-ai-sdk",
    url: "https://web-ai-sdk.dev/",
  },
  ...(canonical
    ? { mainEntityOfPage: { "@type": "WebPage", "@id": canonical } }
    : {}),
};
---

<Default><slot /></Default>
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{data && <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />}
<script>
  import "../scripts/table-scroll.js";
  import "../scripts/type-union-pills.js";
  import "../scripts/inline-code-copy.js";
</script>
