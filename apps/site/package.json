{
  "name": "@web-ai-sdk-apps/site",
  "version": "0.0.0",
  "private": true,
  "description": "Unified site for web-ai-sdk (Astro + Starlight docs + React islands)",
  "type": "module",
  "scripts": {
    "dev": "astro dev --strictPort",
    "build": "astro build && node scripts/build-llms.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "og:build": "node scripts/build-og-image.mjs",
    "llms:build": "node scripts/build-llms.mjs",
    "docs:sync": "node scripts/sync-package-docs.mjs",
    "docs:check": "node scripts/sync-package-docs.mjs --check"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.1",
    "@web-ai-sdk/detector": "workspace:*",
    "@web-ai-sdk/prompt": "workspace:*",
    "@web-ai-sdk/proofreader": "workspace:*",
    "@web-ai-sdk/rewriter": "workspace:*",
    "@web-ai-sdk/summarizer": "workspace:*",
    "@web-ai-sdk/translator": "workspace:*",
    "@web-ai-sdk/webmcp": "workspace:*",
    "@web-ai-sdk/writer": "workspace:*",
    "astro": "7.3.3",
    "marked": "^18.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "satteri": "0.10.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
