{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/packages/**/*.ts",
      "**/packages/**/*.tsx",
      "**/apps/**/*.ts",
      "**/apps/**/*.tsx",
      "!**/dist",
      "!**/node_modules",
      "!**/*.d.ts",
      "!**/storybook-static",
      "!**/.astro",
      "!**/_site",
      "!**/.claude/worktrees",
      "!**/.codex/worktrees",
      "!**/.worktrees"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
