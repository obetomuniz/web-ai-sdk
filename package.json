{
  "name": "web-ai-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "Building blocks for the Web's Built-in AI APIs",
  "license": "MIT",
  "author": "Beto Muniz",
  "homepage": "https://github.com/obetomuniz/web-ai-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obetomuniz/web-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/obetomuniz/web-ai-sdk/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @web-ai-sdk-apps/site run dev",
    "dev:packages": "pnpm --filter \"./packages/**\" --filter \"!@web-ai-sdk/all\" -r --parallel run dev",
    "dev:sdk": "pnpm build:packages && pnpm --filter @web-ai-sdk/all run dev",
    "dev:apps": "pnpm dev",
    "dev:docs": "pnpm dev",
    "dev:site": "pnpm --filter @web-ai-sdk-apps/site run dev",
    "docs": "pnpm dev:docs",
    "site": "pnpm dev:site",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm --filter \"./packages/**\" -r run build",
    "build:apps": "pnpm build:site",
    "build:docs": "pnpm build:site",
    "build:site": "pnpm --filter @web-ai-sdk-apps/site run build",
    "preview:docs": "pnpm preview:site",
    "preview:site": "pnpm --filter @web-ai-sdk-apps/site run preview",
    "og:build": "pnpm --filter @web-ai-sdk-apps/site run og:build",
    "llms:build": "pnpm --filter @web-ai-sdk-apps/site run llms:build",
    "docs:check": "pnpm --filter @web-ai-sdk-apps/site run docs:check",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter \"./packages/**\" -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "gate": "pnpm lint && pnpm docs:check && pnpm build && pnpm typecheck && pnpm test",
    "pages:clean": "rm -rf _site",
    "pages:dev": "pnpm dev",
    "pages:build:site": "SITE_BASE=/ pnpm build:site",
    "pages:build:docs": "pnpm pages:build:site",
    "pages:assemble": "mkdir -p _site && cp -R apps/site/dist/. _site/",
    "pages:build": "pnpm pages:clean && pnpm build:packages && pnpm pages:build:site && pnpm pages:assemble",
    "pages:preview": "pnpm pages:build && serve _site -p 4173"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "^2.27.10",
    "serve": "14.2.6",
    "typescript": "^6.0.3"
  }
}
